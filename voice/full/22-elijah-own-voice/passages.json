  "words_per_second": 2.29,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s01-06-story-d86997.wav": {
  "section": 1,
  "mode": "story",
  "text": "For three years, not a drop fell.",
  "seed": 3,
  "words_per_second": 2.4,
  "in_range": false,
  "pitch_movement_st": 0.0
 },
 "s02-01-story-3b5467.wav": {
  "section": 2,
  "mode": "story",
  "text": "Then Elijah called all Israel to Mount Carmel.",
  "seed": 1,
  "words_per_second": 2.48,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s02-02-story-9362c7.wav": {
  "section": 2,
  "mode": "story",
  "text": "And he asked them a question.",
  "seed": 1,
  "words_per_second": 3.49,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s02-03-grave-8f5de1.wav": {
  "section": 2,
  "mode": "grave",
  "text": "How long will you go limping between two different opinions?",
  "seed": 1,
  "words_per_second": 2.92,
  "in_range": false,
  "pitch_movement_st": 0.0
 },
 "s02-04-grave-efa8a3.wav": {
  "section": 2,
  "mode": "grave",
  "text": "If the LORD is God, follow him; but if Baal, then follow him.",
  "seed": 1,
  "words_per_second": 2.39,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s02-05-talk-d0adec.wav": {
  "section": 2,
  "mode": "talk",
  "text": "And the people said nothing.",
  "seed": 1,
  "words_per_second": 3.5,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s02-06-story-bd3716.wav": {
  "section": 2,
  "mode": "story",
  "text": "Not a word.",
  "seed": 1,
  "words_per_second": 2.88,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s03-01-story-dc178b.wav": {
  "section": 3,
  "mode": "story",
  "text": "So Elijah set a test.",
