  "words_per_second": 3.04,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s01-03-story-9309d3.wav": {
  "section": 1,
  "mode": "story",
  "text": "So the prophet Elijah told the king,",
  "seed": 1,
  "words_per_second": 2.93,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s01-04-grave-8a38c1.wav": {
  "section": 1,
  "mode": "grave",
  "text": "As the LORD, the God of Israel, lives, before whom I stand, there shall be neither dew nor rain these years,",
  "seed": 1,
  "words_per_second": 2.69,
  "in_range": true,
  "pitch_movement_st": 0.0
 },
 "s01-05-grave-b17a6b.wav": {
  "section": 1,
  "mode": "grave",
  "text": "except by my word.",
