{
 "s00-grave-cf7a15.wav": {
  "section": 0,
  "kind": "speech",
  "mode": "grave",
  "text": "At the edge of the oldest story in the Bible, there's a gate.",
  "seed": 2,
  "words_per_second": 3.5,
  "in_range": false,
  "compute_seconds": 74.6,
  "audio_seconds": 3.96
 },
 "s00-grave-9d893f.wav": {
  "section": 0,
  "kind": "speech",
  "mode": "grave",
  "text": "On one side, a garden.",
  "seed": 1,
  "words_per_second": 2.63,
  "in_range": true,
  "compute_seconds": 16.9,
  "audio_seconds": 1.96
 },
 "s00-grave-a74a0a.wav": {
  "section": 0,
  "kind": "speech",
  "mode": "grave",
  "text": "On the other, two people walking away.",
  "seed": 1,
  "words_per_second": 2.82,
  "in_range": true,
  "compute_seconds": 19.7,
  "audio_seconds": 2.56
 },
 "s00-grave-206a89.wav": {
  "section": 0,
  "kind": "speech",
  "mode": "grave",
  "text": "And between them, a guard: a flaming sword, turning every way.",
  "seed": 1,
  "words_per_second": 2.74,
  "in_range": true,
  "compute_seconds": 26.7,
  "audio_seconds": 4.16
 },
 "s00-pivot-b8de46.wav": {
  "section": 0,
  "kind": "speech",
  "mode": "pivot",
  "text": "How did it come to this?",
  "seed": 1,
  "words_per_second": 3.39,
  "in_range": true,
  "compute_seconds": 18.0,
  "audio_seconds": 1.84
 },
 "s00-talk-ebcdf9.wav": {
  "section": 0,
  "kind": "speech",
  "mode": "talk",
  "text": "To find out, we have to go back.",
  "seed": 2,
  "words_per_second": 3.81,
  "in_range": true,
  "compute_seconds": 28.4,
  "audio_seconds": 2.1
 },
 "s00-pivot-26e12a.wav": {
  "section": 0,
  "kind": "speech",
  "mode": "pivot",
  "text": "All the way back.",
  "seed": 2,
  "words_per_second": 3.23,
  "in_range": true,
  "compute_seconds": 30.1,
  "audio_seconds": 1.24
 },
 "s01-talk-8ea484.wav": {
  "section": 1,
  "kind": "speech",
  "mode": "talk",
  "text": "It's one of the most famous sentences ever written.",
  "seed": 1,
  "words_per_second": 3.72,
  "in_range": true,
  "compute_seconds": 13.3,
  "audio_seconds": 2.42
 },
 "s01-talk-a40b19.wav": {
  "section": 1,
  "kind": "speech",
  "mode": "talk",
  "text": "And notice what it doesn't explain.",
  "seed": 1,
  "words_per_second": 3.8,
  "in_range": true,
  "compute_seconds": 11.6,
  "audio_seconds": 1.62
 },
 "s01-talk-8e5520.wav": {
  "section": 1,
  "kind": "speech",
  "mode": "talk",
  "text": "It doesn't argue that God exists.",
  "seed": 1,
  "words_per_second": 3.19,
  "in_range": true,
  "compute_seconds": 12.3,
  "audio_seconds": 1.94
 },
 "s01-talk-6b3190.wav": {
  "section": 1,
  "kind": "speech",
  "mode": "talk",
  "text": "It starts with him, already there, already making.",
  "seed": 1,
  "words_per_second": 2.96,
  "in_range": true,
  "compute_seconds": 15.1,
  "audio_seconds": 2.7
 },
 "s01-pivot-740dd5.wav": {
  "section": 1,
  "kind": "speech",
  "mode": "pivot",
  "text": "Then the story drops in close:",
  "seed": 1,
  "words_per_second": 3.33,
  "in_range": true,
  "compute_seconds": 16.7,
  "audio_seconds": 1.88
 },
 "s01-grave-0d9eed.wav": {
  "section": 1,
  "kind": "speech",
  "mode": "grave",
  "text": "No shape. No light. Just water and dark.",
  "seed": 2,
  "words_per_second": 2.67,
  "in_range": true,
  "compute_seconds": 39.2,
  "audio_seconds": 3.0
 },
 "s02-pivot-fdb1bd.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "pivot",
  "text": "Then God speaks.",
  "seed": 3,
  "words_per_second": 2.33,
  "in_range": true,
  "compute_seconds": 45.3,
  "audio_seconds": 1.32
 },
 "s02-talk-e0ec1e.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "talk",
  "text": "Light comes first, three whole days before the sun.",
  "seed": 1,
  "words_per_second": 3.6,
  "in_range": true,
  "compute_seconds": 14.8,
  "audio_seconds": 2.5
 },
 "s02-talk-ef678c.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "talk",
  "text": "Light here doesn't come from anything.",
  "seed": 1,
  "words_per_second": 3.53,
  "in_range": true,
  "compute_seconds": 11.6,
  "audio_seconds": 1.74
 },
 "s02-grave-ed66f4.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "grave",
  "text": "It comes from a word.",
  "seed": 2,
  "words_per_second": 3.47,
  "in_range": false,
  "compute_seconds": 43.3,
  "audio_seconds": 1.52
 },
 "s02-story-5e2281.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "What follows is a week of order out of chaos.",
  "seed": 1,
  "words_per_second": 2.96,
  "in_range": true,
  "compute_seconds": 22.5,
  "audio_seconds": 3.4
 },
 "s02-story-d55588.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "On days one to three, God makes spaces: light and dark, sky and sea, dry land.",
  "seed": 1,
  "words_per_second": 2.58,
  "in_range": true,
  "compute_seconds": 34.3,
  "audio_seconds": 6.36
 },
 "s02-story-3636d3.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "On days four to six, he fills them: lights to rule the day and night, fish and birds,",
  "seed": 1,
  "words_per_second": 2.84,
  "in_range": true,
  "compute_seconds": 34.8,
  "audio_seconds": 6.44
 },
 "s02-story-881b48.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "and finally the animals of the land.",
  "seed": 1,
  "words_per_second": 2.55,
  "in_range": true,
  "compute_seconds": 19.6,
  "audio_seconds": 2.8
 },
 "s02-pivot-e8d94f.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "pivot",
  "text": "Then the rhythm breaks.",
  "seed": 2,
  "words_per_second": 2.26,
  "in_range": true,
  "compute_seconds": 33.8,
  "audio_seconds": 1.84
 },
 "s02-story-9cab34.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "For the last creature, God doesn't just say Let there be.",
  "seed": 1,
  "words_per_second": 2.59,
  "in_range": true,
  "compute_seconds": 26.4,
  "audio_seconds": 4.32
 },
 "s02-grave-0c90f4.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "grave",
  "text": "He says: let us make man.",
  "seed": 1,
  "words_per_second": 2.83,
  "in_range": true,
  "compute_seconds": 17.0,
  "audio_seconds": 2.12
 },
 "s02-story-5dd46b.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "Male and female.",
  "seed": 1,
  "words_per_second": 2.21,
  "in_range": false,
  "compute_seconds": 45.3,
  "audio_seconds": 1.36
 },
 "s02-story-74a51c.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "Not the biggest creatures, not the strongest, but the only ones said to carry his image.",
  "seed": 1,
  "words_per_second": 2.8,
  "in_range": true,
  "compute_seconds": 31.7,
  "audio_seconds": 5.8
 },
 "s02-grave-fb8aad.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "grave",
  "text": "And at the end of it all, God looks over everything he's made, and it is very good.",
  "seed": 3,
  "words_per_second": 3.63,
  "in_range": false,
  "compute_seconds": 84.6,
  "audio_seconds": 5.04
 },
 "s02-pivot-53f725.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "pivot",
  "text": "Not just good.",
  "seed": 1,
  "words_per_second": 3.33,
  "in_range": true,
  "compute_seconds": 17.1,
  "audio_seconds": 2.04
 },
 "s02-story-78555e.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "story",
  "text": "Very good.",
  "seed": 1,
  "words_per_second": 2.53,
  "in_range": true,
  "compute_seconds": 13.1,
  "audio_seconds": 0.96
 },
 "s02-grave-07e899.wav": {
  "section": 2,
  "kind": "speech",
  "mode": "grave",
  "text": "On the seventh day, he rests.",
  "seed": 2,
  "words_per_second": 2.83,
  "in_range": true,
  "compute_seconds": 32.7,
  "audio_seconds": 2.12
 },
 "s03-talk-84893c.wav": {
  "section": 3,
  "kind": "speech",
  "mode": "talk",
  "text": "Chapter two zooms in.",
  "seed": 2,
  "words_per_second": 3.03,
  "in_range": true,
  "compute_seconds": 21.9,
  "audio_seconds": 1.38
 },
 "s03-talk-df8553.wav": {
  "section": 3,
  "kind": "speech",
  "mode": "talk",
  "text": "It tells the same story again, closer and more personal.",
  "seed": 1,
  "words_per_second": 3.19,
  "in_range": true,
  "compute_seconds": 17.1,
  "audio_seconds": 3.26
 },
 "s03-talk-24ca8d.wav": {
  "section": 3,
  "kind": "speech",
  "mode": "talk",
  "text": "Now God is called the Lord God, and he works with his hands.",
  "seed": 3,
  "words_per_second": 3.85,
  "in_range": true,
  "compute_seconds": 51.1,
  "audio_seconds": 3.5
 },
 "s03-story-adb2c0.wav": {
  "section": 3,
  "kind": "speech",
  "mode": "story",
  "text": "The first human is made of two things: earth and breath.",
  "seed": 1,
  "words_per_second": 2.5,
  "in_range": true,
  "compute_seconds": 26.9,
  "audio_seconds": 4.44
 },
 "s03-story-08a810.wav": {
  "section": 3,
  "kind": "speech",
  "mode": "story",
  "text": "Dust, and something far more than dust.",
  "seed": 1,
  "words_per_second": 2.37,
  "in_range": false,
  "compute_seconds": 63.9,
  "audio_seconds": 3.04
 },
 "s04-story-40b535.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "story",
  "text": "Then God plants a garden, in the east, in Eden, and puts the man there.",
  "seed": 1,
  "words_per_second": 3.01,
  "in_range": true,
  "compute_seconds": 29.3,
  "audio_seconds": 5.16
 },
 "s04-story-898c7d.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "story",
  "text": "Genesis even names its rivers.",
  "seed": 1,
  "words_per_second": 2.4,
  "in_range": true,
  "compute_seconds": 17.5,
  "audio_seconds": 2.12
 },
 "s04-story-4fca17.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "story",
  "text": "Two of them still have names we know: the Tigris, which older translations call the Hid-deh-kel,",
  "seed": 3,
  "words_per_second": 2.34,
  "in_range": false,
  "compute_seconds": 112.3,
  "audio_seconds": 6.92
 },
 "s04-story-6fe545.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "story",
  "text": "and the Euphrates.",
  "seed": 3,
  "words_per_second": 2.86,
  "in_range": true,
  "compute_seconds": 45.2,
  "audio_seconds": 1.12
 },
 "s04-pivot-991b03.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "pivot",
  "text": "So where was Eden?",
  "seed": 1,
  "words_per_second": 3.23,
  "in_range": true,
  "compute_seconds": 14.0,
  "audio_seconds": 1.24
 },
 "s04-talk-bb9e9b.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "talk",
  "text": "Honestly, nobody knows.",
  "seed": 2,
  "words_per_second": 1.81,
  "in_range": false,
  "compute_seconds": 36.1,
  "audio_seconds": 1.66
 },
 "s04-talk-37c767.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "talk",
  "text": "The other two rivers can't be identified, and people have suggested sites from Mesopotamia to Armenia.",
  "seed": 1,
  "words_per_second": 3.55,
  "in_range": true,
  "compute_seconds": 22.8,
  "audio_seconds": 4.58
 },
 "s04-talk-756e5b.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "talk",
  "text": "The map can point us toward a region.",
  "seed": 3,
  "words_per_second": 4.08,
  "in_range": false,
  "compute_seconds": 37.6,
  "audio_seconds": 2.06
 },
 "s04-talk-cffc0e.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "talk",
  "text": "It can't put a pin in it.",
  "seed": 2,
  "words_per_second": 5.22,
  "in_range": false,
  "compute_seconds": 31.0,
  "audio_seconds": 1.34
 },
 "s04-story-f1e2af.wav": {
  "section": 4,
  "kind": "speech",
  "mode": "story",
  "text": "But the picture is clear enough: a place full of life, with water and fruit, and with God close by.",
  "seed": 1,
  "words_per_second": 3.02,
  "in_range": true,
  "compute_seconds": 36.4,
  "audio_seconds": 6.68
 },
 "s05-story-7ece0e.wav": {
  "section": 5,
  "kind": "speech",
  "mode": "story",
  "text": "In the middle of the garden stand two trees: the tree of life, and the tree of the knowledge of good and evil.",
  "seed": 1,
  "words_per_second": 3.56,
  "in_range": true,
  "compute_seconds": 35.6,
  "audio_seconds": 6.56
 },
 "s05-talk-90b13c.wav": {
  "section": 5,
  "kind": "speech",
  "mode": "talk",
  "text": "And here God gives the only rule in paradise.",
  "seed": 3,
  "words_per_second": 3.85,
  "in_range": true,
  "compute_seconds": 41.5,
  "audio_seconds": 2.34
 },
 "s05-story-e3041c.wav": {
  "section": 5,
  "kind": "speech",
  "mode": "story",
  "text": "Eat freely from every tree, except one.",
  "seed": 1,
  "words_per_second": 2.66,
  "in_range": true,
  "compute_seconds": 19.4,
  "audio_seconds": 2.72
 },
 "s05-talk-90f6f2.wav": {
  "section": 5,
  "kind": "speech",
  "mode": "talk",
  "text": "One limit, in a garden full of yeses. Hold on to that not.",
  "seed": 3,
  "words_per_second": 3.71,
  "in_range": true,
  "compute_seconds": 52.6,
  "audio_seconds": 3.5
 },
 "s05-pivot-285eb4.wav": {
  "section": 5,
  "kind": "speech",
  "mode": "pivot",
  "text": "It's about to be argued with.",
  "seed": 1,
  "words_per_second": 3.26,
  "in_range": true,
  "compute_seconds": 16.5,
  "audio_seconds": 1.92
 },
 "s06-grave-98dd5b.wav": {
  "section": 6,
  "kind": "speech",
  "mode": "grave",
  "text": "For the first time in the story, something is not good.",
  "seed": 1,
  "words_per_second": 2.99,
  "in_range": false,
  "compute_seconds": 64.3,
  "audio_seconds": 3.72
 },
 "s06-story-e53392.wav": {
  "section": 6,
  "kind": "speech",
  "mode": "story",
  "text": "Adam names every animal, but none of them is a match.",
  "seed": 3,
  "words_per_second": 3.12,
  "in_range": true,
  "compute_seconds": 65.7,
  "audio_seconds": 3.68
 },
 "s06-story-edbbd0.wav": {
  "section": 6,
  "kind": "speech",
  "mode": "story",
  "text": "So God makes the woman from the man's own side, and brings her to him.",
  "seed": 1,
  "words_per_second": 3.22,
  "in_range": true,
  "compute_seconds": 28.5,
  "audio_seconds": 4.68
 },
 "s06-story-5d68e4.wav": {
  "section": 6,
  "kind": "speech",
  "mode": "story",
  "text": "And the first recorded human words are a kind of poem:",
  "seed": 1,
  "words_per_second": 2.66,
  "in_range": true,
  "compute_seconds": 25.6,
  "audio_seconds": 4.2
 },
 "s06-story-23f4db.wav": {
  "section": 6,
  "kind": "speech",
  "mode": "story",
  "text": "Two people, made for each other, with nothing to hide.",
  "seed": 1,
  "words_per_second": 2.85,
  "in_range": true,
  "compute_seconds": 23.8,
  "audio_seconds": 3.56
 },
 "s07-pivot-e27b72.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "pivot",
  "text": "Then a new character slides into the story.",
  "seed": 1,
  "words_per_second": 2.4,
  "in_range": true,
  "compute_seconds": 22.5,
  "audio_seconds": 3.4
 },
 "s07-talk-3e7f1b.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "talk",
  "text": "Genesis doesn't say where it came from.",
  "seed": 1,
  "words_per_second": 3.65,
  "in_range": true,
  "compute_seconds": 12.9,
  "audio_seconds": 2.02
 },
 "s07-talk-d2b6ea.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "talk",
  "text": "Later writers would connect it with Satan, but here it's simply a voice, and a clever one.",
  "seed": 2,
  "words_per_second": 4.11,
  "in_range": false,
  "compute_seconds": 59.9,
  "audio_seconds": 4.18
 },
 "s07-talk-68793f.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "talk",
  "text": "And it opens not with a lie, but with a question.",
  "seed": 2,
  "words_per_second": 4.4,
  "in_range": false,
  "compute_seconds": 43.4,
  "audio_seconds": 2.66
 },
 "s07-talk-3c7411.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "talk",
  "text": "Did God really say you can't eat from any tree in the garden?",
  "seed": 3,
  "words_per_second": 4.32,
  "in_range": false,
  "compute_seconds": 48.1,
  "audio_seconds": 3.06
 },
 "s07-talk-305f09.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "talk",
  "text": "It takes God's one no and makes it sound like a thousand.",
  "seed": 3,
  "words_per_second": 3.86,
  "in_range": true,
  "compute_seconds": 53.0,
  "audio_seconds": 3.22
 },
 "s07-story-3724a5.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "story",
  "text": "The woman corrects it, and then the serpent goes further.",
  "seed": 1,
  "words_per_second": 3.01,
  "in_range": true,
  "compute_seconds": 24.8,
  "audio_seconds": 3.4
 },
 "s07-talk-9522b1.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "talk",
  "text": "Put the two sentences side by side.",
  "seed": 3,
  "words_per_second": 3.8,
  "in_range": true,
  "compute_seconds": 38.4,
  "audio_seconds": 1.9
 },
 "s07-talk-4bdaec.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "talk",
  "text": "God said you must not eat of it. The serpent says:",
  "seed": 1,
  "words_per_second": 3.86,
  "in_range": true,
  "compute_seconds": 16.1,
  "audio_seconds": 2.9
 },
 "s07-pivot-246728.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "pivot",
  "text": "Same little word, moved one place.",
  "seed": 2,
  "words_per_second": 2.24,
  "in_range": true,
  "compute_seconds": 43.3,
  "audio_seconds": 2.72
 },
 "s07-story-1c4dde.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "story",
  "text": "And then it offers a reason.",
  "seed": 1,
  "words_per_second": 2.44,
  "in_range": true,
  "compute_seconds": 19.1,
  "audio_seconds": 2.48
 },
 "s07-story-7e7d7c.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "story",
  "text": "If you eat, your eyes will be opened, and you'll be like God, knowing good and evil.",
  "seed": 1,
  "words_per_second": 3.46,
  "in_range": true,
  "compute_seconds": 28.9,
  "audio_seconds": 5.0
 },
 "s07-grave-de014b.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "grave",
  "text": "The real temptation isn't fruit.",
  "seed": 2,
  "words_per_second": 2.49,
  "in_range": true,
  "compute_seconds": 33.4,
  "audio_seconds": 2.08
 },
 "s07-grave-6ae92b.wav": {
  "section": 7,
  "kind": "speech",
  "mode": "grave",
  "text": "It's the idea that God is holding something back.",
  "seed": 1,
  "words_per_second": 2.9,
  "in_range": false,
  "compute_seconds": 68.5,
  "audio_seconds": 3.2
 },
 "s08-story-af6e25.wav": {
  "section": 8,
  "kind": "speech",
  "mode": "story",
  "text": "She looks.",
  "seed": 3,
  "words_per_second": 3.08,
  "in_range": true,
  "compute_seconds": 45.0,
  "audio_seconds": 0.68
 },
 "s08-story-4891df.wav": {
  "section": 8,
  "kind": "speech",
  "mode": "story",
  "text": "The fruit is good for food, a delight to the eyes, and desired to make one wise.",
  "seed": 1,
  "words_per_second": 2.87,
  "in_range": true,
  "compute_seconds": 35.5,
  "audio_seconds": 6.0
 },
 "s08-talk-36ead9.wav": {
  "section": 8,
  "kind": "speech",
  "mode": "talk",
  "text": "Not an apple, by the way.",
  "seed": 3,
  "words_per_second": 5.08,
  "in_range": false,
  "compute_seconds": 35.8,
  "audio_seconds": 1.18
 },
 "s08-talk-8de46f.wav": {
  "section": 8,
  "kind": "speech",
  "mode": "talk",
  "text": "Genesis never says what fruit it was.",
  "seed": 1,
  "words_per_second": 3.48,
  "in_range": true,
  "compute_seconds": 15.3,
  "audio_seconds": 2.1
 },
 "s08-grave-9a0b27.wav": {
  "section": 8,
  "kind": "speech",
  "mode": "grave",
  "text": "What matters is what it costs.",
  "seed": 1,
  "words_per_second": 2.33,
  "in_range": true,
  "compute_seconds": 21.6,
  "audio_seconds": 2.68
 },
 "s09-story-ec0320.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "story",
  "text": "Then the eyes of both of them are opened.",
  "seed": 2,
  "words_per_second": 3.57,
  "in_range": true,
  "compute_seconds": 57.9,
  "audio_seconds": 2.52
 },
 "s09-story-e25132.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "story",
  "text": "The serpent was right that they'd know something new.",
  "seed": 1,
  "words_per_second": 3.52,
  "in_range": true,
  "compute_seconds": 25.1,
  "audio_seconds": 2.6
 },
 "s09-story-fe6054.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "story",
  "text": "It just didn't tell them what.",
  "seed": 1,
  "words_per_second": 3.26,
  "in_range": true,
  "compute_seconds": 27.0,
  "audio_seconds": 1.92
 },
 "s09-grave-d01ac7.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "grave",
  "text": "What they knew first was shame.",
  "seed": 1,
  "words_per_second": 2.78,
  "in_range": true,
  "compute_seconds": 33.0,
  "audio_seconds": 2.16
 },
 "s09-story-842f79.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "story",
  "text": "They cover themselves, and when they hear the Lord God in the garden, they hide.",
  "seed": 1,
  "words_per_second": 2.94,
  "in_range": true,
  "compute_seconds": 49.2,
  "audio_seconds": 5.2
 },
 "s09-pivot-69fb41.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "pivot",
  "text": "Then comes the first question God asks a human being:",
  "seed": 1,
  "words_per_second": 2.51,
  "in_range": true,
  "compute_seconds": 50.0,
  "audio_seconds": 4.08
 },
 "s09-talk-6b7c01.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "talk",
  "text": "Not because God doesn't know.",
  "seed": 1,
  "words_per_second": 3.65,
  "in_range": true,
  "compute_seconds": 23.2,
  "audio_seconds": 1.42
 },
 "s09-talk-04c6b5.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "talk",
  "text": "It's an invitation to come out.",
  "seed": 1,
  "words_per_second": 3.8,
  "in_range": true,
  "compute_seconds": 20.2,
  "audio_seconds": 1.62
 },
 "s09-pivot-7f0d2b.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "pivot",
  "text": "Instead, the blame starts.",
  "seed": 2,
  "words_per_second": 1.82,
  "in_range": false,
  "compute_seconds": 110.0,
  "audio_seconds": 2.32
 },
 "s09-story-f78538.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "story",
  "text": "The man points at the woman, and at God who gave her:",
  "seed": 1,
  "words_per_second": 3.13,
  "in_range": true,
  "compute_seconds": 43.0,
  "audio_seconds": 3.88
 },
 "s09-story-73e95d.wav": {
  "section": 9,
  "kind": "speech",
  "mode": "story",
  "text": "The woman points at the serpent:",
  "seed": 1,
  "words_per_second": 2.82,
  "in_range": true,
  "compute_seconds": 30.1,
  "audio_seconds": 2.16
 },
 "s10-story-f442f7.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "story",
  "text": "Every relationship cracks. Between people and the serpent.",
  "seed": 2,
  "words_per_second": 1.69,
  "in_range": false,
  "compute_seconds": 140.6,
  "audio_seconds": 4.76
 },
 "s10-story-1946af.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "story",
  "text": "Between husband and wife.",
  "seed": 2,
  "words_per_second": 2.99,
  "in_range": true,
  "compute_seconds": 45.9,
  "audio_seconds": 1.36
 },
 "s10-story-b10ff9.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "story",
  "text": "Between humans and the ground they were made from, which now fights back with thorns and sweat.",
  "seed": 1,
  "words_per_second": 3.15,
  "in_range": true,
  "compute_seconds": 83.6,
  "audio_seconds": 5.6
 },
 "s10-grave-865ffa.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "grave",
  "text": "And at the end of it:",
  "seed": 3,
  "words_per_second": 5.5,
  "in_range": false,
  "compute_seconds": 71.5,
  "audio_seconds": 1.12
 },
 "s10-pivot-16754a.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "pivot",
  "text": "But tucked inside the curse on the serpent is a strange promise.",
  "seed": 1,
  "words_per_second": 2.95,
  "in_range": true,
  "compute_seconds": 43.8,
  "audio_seconds": 4.16
 },
 "s10-story-509e55.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "story",
  "text": "One of the woman's descendants will crush the serpent's head, even as the serpent strikes his heel.",
  "seed": 1,
  "words_per_second": 3.02,
  "in_range": true,
  "compute_seconds": 38.5,
  "audio_seconds": 5.68
 },
 "s10-talk-b35458.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "talk",
  "text": "Christians have long read this as the first hint of a rescue.",
  "seed": 2,
  "words_per_second": 3.88,
  "in_range": true,
  "compute_seconds": 38.4,
  "audio_seconds": 3.18
 },
 "s10-story-1f557c.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "story",
  "text": "And before they leave, God himself makes them clothes.",
  "seed": 1,
  "words_per_second": 2.49,
  "in_range": true,
  "compute_seconds": 28.0,
  "audio_seconds": 3.76
 },
 "s10-grave-4b87e2.wav": {
  "section": 10,
  "kind": "speech",
  "mode": "grave",
  "text": "Judgement, but also care.",
  "seed": 1,
  "words_per_second": 2.4,
  "in_range": true,
  "compute_seconds": 17.5,
  "audio_seconds": 1.72
 }
}